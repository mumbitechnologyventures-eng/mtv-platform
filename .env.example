# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
VITE_SUPABASE_URL=https://fqqcxznrrtastywwcgyv.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# --- Payments (Flutterwave) ---
# Browser-safe PUBLIC key (needed for the /start flow to open checkout):
VITE_FLW_PUBLIC_KEY=your_flutterwave_public_key
# Server-only keys — set these in Vercel (Project → Settings → Environment
# Variables), NOT in this file, and never commit them:
#   FLW_SECRET_KEY              Flutterwave secret key
#   SUPABASE_SERVICE_ROLE_KEY   Supabase service-role key
#   SUPABASE_URL               https://fqqcxznrrtastywwcgyv.supabase.co

# --- Site assistant / chatbot (server-only) ---
#   ANTHROPIC_API_KEY          Claude API key — used ONLY by api/chat.js, never the browser.
# Optional guardrail overrides (sensible defaults are built in):
#   CHAT_DAILY_PER_IP=15       max AI messages per visitor per day
#   CHAT_DAILY_GLOBAL=800      max AI messages across all visitors per day (cost brake)
#   CHAT_MAX_INPUT=400         max characters per message
#   CHAT_MAX_TOKENS=200        max tokens per reply
#   CHAT_HISTORY=6             conversation turns sent to the model
